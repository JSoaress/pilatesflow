# Gateway: uma porta pública para a aplicação Next.js e as APIs do Supabase.
# ${PUBLIC_PORT} é substituído pelo entrypoint do nginx (envsubst).
#
# A aplicação compartilha a rede deste contêiner (network_mode: service:gateway),
# então ela escuta em 127.0.0.1:3001 e enxerga http://localhost:${PUBLIC_PORT}
# exatamente como o navegador.

# DNS do Docker; `valid` evita guardar o IP antigo quando um serviço é recriado.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${PUBLIC_PORT};
  server_name _;

  client_max_body_size 50m;
  proxy_http_version 1.1;
  proxy_set_header Host              $http_host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade           $http_upgrade;
  proxy_set_header Connection        $connection_upgrade;
  proxy_read_timeout 120s;

  # GoTrue (prefixo removido)
  location /auth/v1/ {
    set $upstream_auth http://auth:9999;
    rewrite ^/auth/v1/(.*)$ /$1 break;
    proxy_pass $upstream_auth;
  }

  # PostgREST (prefixo removido)
  location /rest/v1/ {
    set $upstream_rest http://rest:3000;
    rewrite ^/rest/v1/(.*)$ /$1 break;
    proxy_pass $upstream_rest;
  }

  # Storage API (prefixo removido)
  location /storage/v1/ {
    set $upstream_storage http://storage:5000;
    rewrite ^/storage/v1/(.*)$ /$1 break;
    proxy_pass $upstream_storage;
    proxy_request_buffering off;
  }

  # Realtime não é usado por este projeto
  location /realtime/v1/ {
    return 404;
  }

  # Todo o resto: aplicação Next.js
  location / {
    proxy_pass http://127.0.0.1:3001;
  }
}
