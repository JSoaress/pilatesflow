# Modelo das variáveis da stack Docker. Copie para .env.docker:
#   cp .env.docker.example .env.docker
# As chaves abaixo são de DESENVOLVIMENTO. Para produção gere novas:
#   node docker/generate-keys.mjs

# ===== Endereço público =====
# Mude PUBLIC_PORT e PUBLIC_URL juntos. PUBLIC_URL entra no bundle do navegador
# no build: se mudar, reconstrua a imagem (make build && make up).
PUBLIC_PORT=3000
PUBLIC_URL=http://localhost:3000

# ===== Banco =====
POSTGRES_PASSWORD=pilatesflow-dev-postgres
POSTGRES_PORT=54322

# ===== Supabase (JWT) =====
JWT_SECRET=pilatesflow-dev-jwt-secret-troque-em-producao-0123456789
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InBpbGF0ZXNmbG93IiwiaWF0IjoxNzkyNTg5Mjg3LCJleHAiOjIxMDc5NDkyODd9.9e_vKjYonp51qzsBYfailyekyjrb7CtkZiX38hUajsE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoicGlsYXRlc2Zsb3ciLCJpYXQiOjE3OTI1ODkyODcsImV4cCI6MjEwNzk0OTI4N30.94r3kPhI1qUh993v6DfdELC-kPGh3TZ592Z8BKQumf4

# ===== Autenticação (GoTrue) =====
# Local: confirma o e-mail automaticamente. Em produção: false + SMTP.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@localhost

# ===== Aplicação =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_ORG_SLUG=studio-movimento
NEXT_PUBLIC_APP_NAME=PilatesFlow
ALLOW_PUBLIC_SIGNUP=true
CRON_SECRET=troque-por-um-segredo-longo
DEMO_PASSWORD=Demo@12345

# ===== Serviço cron (make cron) =====
CRON_MESSAGES_MINUTES=10
CRON_DAILY_HOUR=3

TZ=America/Sao_Paulo

